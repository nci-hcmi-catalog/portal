## Server
AUTH_ENABLED='false'
ENV='dev'
NODE_ENV='dev'
LOG_LEVEL='debug'

## Arranger
SEARCH_ENGINE_AUTH_TYPE=
SEARCH_ENGINE_AUTH_REGION=
SEARCH_ENGINE_AUTH_SERVICE=

# Google
GOOGLE_CLIENT_ID='ADD-ID'
GOOGLE_CLIENT_SECRET='ADD-SECRET'
REDIRECT_URIS=['http://localhost:5050/']

## Mongo
MONGO_DB_NAME='hcmi'
MONGO_COLLECTION='models'
MONGO_USER_COLLECTION='users'
MONGO_URL='http://localhost:27017'
MONGODB_URI='http://localhost:27017/hcmi'

## OpenSearch
ES_USER='elastic'
ES_PASS='password'
ES_PORT=9200
ES_URL='http://localhost:9200'
ES_HOST='http://localhost'

## S3
IAM_USER_KEY='ADD-KEY'
IAM_USER_SECRET='ADD-SECRET'
S3_BUCKET='hcmi-demo'

