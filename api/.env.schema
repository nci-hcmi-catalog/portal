## Server
ENV=dev
ENABLE_ADMIN=false
LOG_LEVEL='debug'
PORT=5050

## OpenSearch
ES_USER='elastic'
ES_PASS='password'
ES_UPDATE_INDEX='hcmi-update'
## For Local Development
ES_URL='http://localhost:9200'
ES_HOST='http://localhost:9200'
## For Use with Docker
# ES_URL='http://opensearch:9200'
# ES_HOST='http://localhost:9200'

## Arranger
DISABLE_GRAPHQL_INTROSPECTION=false
PROJECT_ID='hcmi'
SEARCH_ENGINE_AUTH_TYPE=
SEARCH_ENGINE_AUTH_SERVICE=
SEARCH_ENGINE_AUTH_REGION=

